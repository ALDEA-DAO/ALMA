// Soulbound Protocol — SoulboundCredentialContract
// Main credential contract on Midnight (ZK/shielded).
// Maintained by AdaSouls Labs.
//
// This contract implements the private layer of the protocol:
//   - Each credential's state is shielded (never exposed on-chain)
//   - Operations are proven via ZK circuits (Kachina/Compact)
//   - Holder wallet addresses NEVER leave the contract
//
// Exported circuits:
//   issue()                    — Issue credential (PENDING)
//   claim()                    — Claim credential (→ CLAIMED)
//   revoke()                   — Revoke credential (→ REVOKED)
//   generate_membership_proof()— ZK membership proof
//   verify_membership_proof()  — Verify proof
//   rotate_admin()             — Rotate admin key (M-01 fix)
//
// Privacy architecture:
//   - ledger credentials: Map[id → CredentialRecord] — shielded, only accessible by this contract
//   - ledger claimed/revoked: Sets of IDs — append-only updates (immutable)
//   - Wallet hashes derived from secret keys via persistent_hash (ZK-friendly)
//   - generate_membership_proof proves ownership without revealing the wallet

export {issue, claim, revoke, generate_membership_proof, verify_membership_proof, rotate_admin}

include "std";

// ─── Types ────────────────────────────────────────────────────────────────────

// Shielded record for each soulbound credential
struct CredentialRecord {
  credential_hash     : Bytes[32];  // Hash of the full credential data
  issuer_org_id       : Bytes[32];  // PolicyId of the issuer (from Cardano SoulboundRegistry)
  subject_wallet_hash : Bytes[32];  // Hash of the holder's wallet (NEVER exposed)
  schema_id           : Bytes[32];  // Hash of the schemaId ("soulbound:v1:access", etc.)
  issued_at           : Unsigned Integer[64];  // Unix timestamp of issuance
  expires_at          : Unsigned Integer[64];  // Unix timestamp of expiration (0 = never expires)
}

// Output of generate_membership_proof — publicly verifiable
struct MembershipProofOutput {
  proof_hash      : Bytes[32];   // Cryptographic hash of the proof (unique per nonce)
  resource_id     : Bytes[32];   // The resource being accessed
  org_id          : Bytes[32];   // The issuer that issued the credential
  nonce           : Bytes[32];   // Prevents replay attacks
}

// ─── Ledger (shielded state) ─────────────────────────────────────────────────

ledger admin_pk   : Cell[Bytes[32]];            // Admin/issuer public key
ledger credentials: Map[Bytes[32], CredentialRecord];  // credentialId → record
ledger claimed    : Set[Bytes[32]];             // IDs of CLAIMED credentials
ledger revoked    : Set[Bytes[32]];             // IDs of REVOKED credentials
ledger revocation_anchors: Map[Bytes[32], Bytes[32]]; // credentialId → Cardano anchor

// ─── Constructor ──────────────────────────────────────────────────────────────

// Initialize the contract with the admin (issuing organization).
// The admin is who can call issue() and revoke().
constructor() {
  const sk = private$admin_secret_key();
  admin_pk.write(derive_admin_pk(sk));
}

// ─── Witnesses (private inputs) ──────────────────────────────────────────────

// Admin's secret key (issuing organization — only they know it)
witness private$admin_secret_key(): Bytes[32];

// Holder's wallet secret key
witness private$wallet_secret_key(): Bytes[32];

// Credential ID for verification (private — verifier never learns which credential was used)
witness private$verification_cred_id(): Bytes[32];

// ─── Helper functions (not exported) ─────────────────────────────────────────

circuit derive_admin_pk(sk: Bytes[32]): Bytes[32] {
  return persistent_hash[Vector[2, Bytes[32]]]([pad(32, "soulbound:admin:pk:"), sk]);
}

// Derives the wallet hash from the holder's secret key.
// This is the core ZK function: subjectWalletHash = derive_wallet_hash(sk)
// The holder can prove they know sk without revealing it.
circuit derive_wallet_hash(sk: Bytes[32]): Bytes[32] {
  return persistent_hash[Vector[2, Bytes[32]]]([pad(32, "soulbound:wallet:"), sk]);
}

// Derives a unique credential ID from its data
circuit derive_credential_id(record: CredentialRecord): Bytes[32] {
  return persistent_hash[CredentialRecord](record);
}

// Checks if a credential is expired.
// expires_at == 0 means it never expires.
circuit is_valid_time(expires_at: Unsigned Integer[64], current_time: Unsigned Integer[64]): Boolean {
  return expires_at == 0 || current_time <= expires_at;
}

// Maximum allowed proof age in seconds (5 minutes).
// Verifiers should reject proofs with generatedAt older than this.
// (L-01) current_time is caller-provided and not validated on-chain.
// Verifiers MUST independently check proof freshness against their own clock.
const MAX_PROOF_AGE_SECONDS: Unsigned Integer[64] = 300;

// ─── issue() ─────────────────────────────────────────────────────────────────
//
// Issue a new soulbound credential in PENDING state.
// Only the admin (issuing organization) can call this function.
//
// Stays PENDING until the holder calls claim().
// The holder is identified by their wallet hash (not their public address).
//
// @returns credentialId — unique credential ID (Bytes[32])
circuit issue(
  credential_hash     : Bytes[32],
  issuer_org_id       : Bytes[32],
  subject_wallet_hash : Bytes[32],
  schema_id           : Bytes[32],
  issued_at           : Unsigned Integer[64],
  expires_at          : Unsigned Integer[64]
): Bytes[32] {
  // Only admin can issue
  const sk = private$admin_secret_key();
  const apk = derive_admin_pk(sk);
  assert (apk == admin_pk.read()) "issue: only the admin can issue credentials";

  // (M-02) Timestamp validation — defense-in-depth against malformed credentials
  assert (issued_at > 0) "issue: issued_at must be a positive timestamp";
  assert (expires_at == 0 || expires_at > issued_at)
    "issue: expires_at must be 0 (never) or after issued_at";

  const record = new CredentialRecord(
    credential_hash,
    issuer_org_id,
    subject_wallet_hash,
    schema_id,
    issued_at,
    expires_at
  );

  const cred_id = derive_credential_id(record);
  assert !credentials.member(cred_id) "issue: credential already exists";

  credentials.insert(cred_id, record);
  return cred_id;
}

// ─── claim() ─────────────────────────────────────────────────────────────────
//
// The holder claims a PENDING credential.
// Requires proving wallet ownership via ZK (without revealing the private key).
//
// The circuit proves:
//   1. The credential exists and is PENDING (not claimed, not revoked)
//   2. The caller knows a secret key such that derive_wallet_hash(sk) == subjectWalletHash
//
// What it does NOT reveal:
//   - The holder's secret key
//   - The wallet address
circuit claim(cred_id: Bytes[32]): Void {
  assert credentials.member(cred_id) "claim: credential not found";
  assert !claimed.member(cred_id) "claim: credential already claimed";
  assert !revoked.member(cred_id) "claim: credential is revoked";

  const record = credentials.lookup(cred_id);
  assert record.is_some "claim: unexpected missing record";

  // ZK ownership proof: prove the caller is the legitimate holder
  const sk = private$wallet_secret_key();
  const wallet_hash = derive_wallet_hash(sk);
  assert (wallet_hash == record.value.subject_wallet_hash)
    "claim: wallet does not match this credential";

  claimed.insert(cred_id);
}

// ─── revoke() ────────────────────────────────────────────────────────────────
//
// The admin revokes an issued credential.
// Only the admin can revoke — not the holder.
//
// Revocation includes a "revocation anchor" (Cardano tx hash) that
// enables public anchoring on Cardano without revealing the holder's identity.
//
// @param cred_id           — ID of the credential to revoke
// @param revocation_anchor — Hash of the Cardano tx publishing the revocation
circuit revoke(cred_id: Bytes[32], revocation_anchor: Bytes[32]): Void {
  assert credentials.member(cred_id) "revoke: credential not found";
  assert !revoked.member(cred_id) "revoke: credential already revoked";

  // Only admin can revoke
  const sk = private$admin_secret_key();
  const apk = derive_admin_pk(sk);
  assert (apk == admin_pk.read()) "revoke: only the admin can revoke credentials";

  revoked.insert(cred_id);
  revocation_anchors.insert(cred_id, revocation_anchor);
}

// ─── rotate_admin() ─────────────────────────────────────────────────────────
//
// (M-01) Rotate the admin key to a new key pair.
// Only the current admin can call this — they must prove knowledge of the
// current secret key. This allows recovery from key compromise without
// redeploying the contract or losing credential state.
//
// The new admin is identified by their secret key, from which we derive
// the new public key. This ensures the new admin already has their key.
//
// @param new_admin_secret_key — The new admin's secret key
circuit rotate_admin(new_admin_secret_key: Bytes[32]): Void {
  // Prove current admin identity
  const sk = private$admin_secret_key();
  const apk = derive_admin_pk(sk);
  assert (apk == admin_pk.read()) "rotate_admin: only the current admin can rotate keys";

  // Derive and set new admin public key
  const new_apk = derive_admin_pk(new_admin_secret_key);

  // Ensure new key is different from current key (prevent no-op rotation)
  assert (new_apk != apk) "rotate_admin: new admin key must be different from current";

  admin_pk.write(new_apk);
}

// ─── generate_membership_proof() ─────────────────────────────────────────────
//
// THE HEART OF THE PROTOCOL.
//
// Generates a ZK Proof that demonstrates:
//   "This wallet has a valid CLAIMED credential from this organization
//    for this resource, and it is not expired or revoked"
//
// Without revealing:
//   - The holder's wallet address or private key
//   - The full credential contents
//   - Which specific credential is being used (within the organization)
//
// The proof output is a unique hash per (credentialId, resourceId, walletHash, nonce).
// The nonce prevents replay attacks — each access generates a different proof.
//
// Public inputs:  resource_id, expected_org_id, current_time, nonce
// Private inputs: wallet_secret_key (via witness), cred_id
// Public output:  MembershipProofOutput (contains proof_hash, but NO wallet info)
//
// IMPORTANT (L-01): current_time is provided by the caller and NOT validated
// against any on-chain time source. Verifiers MUST independently check
// proof.generatedAt against their own clock and reject proofs older than
// MAX_PROOF_AGE_SECONDS (300s / 5 minutes). A holder could lie about
// current_time to bypass expiration — verifier-side freshness checks are
// the mitigation.
circuit generate_membership_proof(
  cred_id          : Bytes[32],
  resource_id      : Bytes[32],
  expected_org_id  : Bytes[32],
  current_time     : Unsigned Integer[64],
  nonce            : Bytes[32]
): MembershipProofOutput {
  // 1. Credential exists
  assert credentials.member(cred_id) "proof: credential not found";

  // 2. Is CLAIMED (not PENDING, not REVOKED)
  assert claimed.member(cred_id) "proof: credential not claimed";
  assert !revoked.member(cred_id) "proof: credential is revoked";

  const record = credentials.lookup(cred_id);
  assert record.is_some "proof: unexpected missing record";

  // 3. Not expired
  assert is_valid_time(record.value.expires_at, current_time)
    "proof: credential is expired";

  // 4. Issuer matches
  assert (record.value.issuer_org_id == expected_org_id)
    "proof: org ID does not match expected";

  // 5. ZK ownership: the caller knows sk such that derive_wallet_hash(sk) == subjectWalletHash
  //    This is the cryptographic proof that the caller IS the legitimate holder
  const sk = private$wallet_secret_key();
  const wallet_hash = derive_wallet_hash(sk);
  assert (wallet_hash == record.value.subject_wallet_hash)
    "proof: wallet does not match credential";

  // 6. Build the proof hash: unique binding of (credential, resource, wallet, nonce)
  //    The wallet_hash enters the proof hash — binding it to this specific holder —
  //    but the wallet_hash itself is NOT revealed to the verifier (only inside the hash)
  const proof_hash = persistent_hash[Vector[5, Bytes[32]]]([
    pad(32, "soulbound:proof:v1:"),
    cred_id,
    resource_id,
    wallet_hash,
    nonce
  ]);

  return new MembershipProofOutput(
    proof_hash,
    resource_id,
    expected_org_id,
    nonce
  );
}

// ─── verify_membership_proof() ───────────────────────────────────────────────
//
// Verifies a MembershipProof issued by generate_membership_proof().
//
// Any contract or actor can verify — no private inputs required.
// Verification checks that the proof_hash is consistent with the current
// ledger state (credential not revoked, correct issuer).
//
// Design note: in Midnight, if generate_membership_proof() executed
// correctly as a ZK circuit, the proof IS valid by construction
// (the ZK system guarantees it). verify_membership_proof() adds an
// explicit on-chain verification layer, useful for contracts that want
// to verify the proof without trusting the SDK.
//
// Security (H-01 fix): cred_id is now a private input (witness) instead of
// a public parameter. The verifier provides only the MembershipProofOutput
// fields (proof_hash, resource_id, org_id, nonce). The contract internally
// searches its ledger for a matching credential without revealing which one
// was used. This prevents usage pattern tracking via cred_id correlation.
//
// @returns Boolean — true if the proof is valid for these parameters
circuit verify_membership_proof(
  proof_hash       : Bytes[32],
  resource_id      : Bytes[32],
  expected_org_id  : Bytes[32],
  nonce            : Bytes[32]
): Boolean {
  // The credential ID is a private input — the verifier never learns which
  // credential was used, only that a valid one exists for this org/resource.
  const cred_id = private$verification_cred_id();

  // Credential must exist and be in valid state
  if (!credentials.member(cred_id)) { return false; }
  if (!claimed.member(cred_id))     { return false; }
  if (revoked.member(cred_id))      { return false; }

  const record = credentials.lookup(cred_id);
  if (!record.is_some) { return false; }

  // Issuer must match
  if (record.value.issuer_org_id != expected_org_id) { return false; }

  // Re-derive the expected proof hash using the stored subject_wallet_hash
  // (shielded — the wallet hash never leaves the contract)
  const expected_proof_hash = persistent_hash[Vector[5, Bytes[32]]]([
    pad(32, "soulbound:proof:v1:"),
    cred_id,
    resource_id,
    record.value.subject_wallet_hash,
    nonce
  ]);

  return proof_hash == expected_proof_hash;
}
