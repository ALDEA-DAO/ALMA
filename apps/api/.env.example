# ALMA API — Environment Variables
# Copy to .env and fill in values

# Server
PORT=3100
NODE_ENV=development
API_URL=http://localhost:3100
FRONTEND_URL=http://localhost:3000

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CENTS=1500

# Mercado Pago
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_PRICE_ARS=15000

# ALDEA
ALDEA_POLICY_ID=aldea-dao-policy-id
ALDEA_PUBLIC_KEY=
ALDEA_TREASURY_ADDRESS=
MINT_PRICE_LOVELACE=35000000

# Midnight
MIDNIGHT_NODE_URL=ws://localhost:9944
MIDNIGHT_PROOF_SERVER_URL=http://localhost:6300
MIDNIGHT_CREDENTIAL_CONTRACT=

# Cardano
BLOCKFROST_PROJECT_ID=
BLOCKFROST_URL=https://cardano-preprod.blockfrost.io/api/v0

# Backend Cardano wallet (for on-chain fiat receipts)
# Generate with: node -e "import('@meshsdk/core').then(({MeshWallet})=>{const m=MeshWallet.brew();console.log(m.join(' '))})"
BACKEND_WALLET_SEED=
PUBLIC_MINT_SCRIPT_ADDRESS=

# Database (Neon Postgres)
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
