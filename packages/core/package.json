{
  "name": "@adasouls/soulbound-core",
  "version": "0.1.0-alpha.1",
  "description": "Soulbound Protocol — Core type definitions and schema validators for soulbound credentials on Cardano + Midnight",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/adasouls-labs/soulbound-protocol",
    "directory": "packages/core"
  },
  "keywords": ["adasouls", "soulbound", "credentials", "cardano", "midnight", "zk-proofs", "web3"],
  "files": ["dist", "package.json", "README.md"],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./schemas": {
      "import": "./dist/schemas/index.js",
      "types": "./dist/schemas/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
