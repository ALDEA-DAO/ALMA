# ALMA Protocol — Variables de entorno
# Copiar este archivo como .env y completar los valores reales.
# NUNCA commitear el archivo .env con valores reales.

# ─── Midnight ─────────────────────────────────────────────────────────────────

# URL del proof server (local via Docker)
MIDNIGHT_PROOF_SERVER_URL=http://localhost:6300

# URL del nodo Midnight (local via Docker o testnet remoto)
MIDNIGHT_NODE_URL=ws://localhost:9944

# Preset de red del nodo Midnight: testnet-02 | qanet
MIDNIGHT_CFG_PRESET=testnet-02

# Puerto del proof server (si necesitas cambiarlo por conflicto)
PROOF_SERVER_PORT=6300

# Puerto RPC WebSocket del nodo Midnight
MIDNIGHT_NODE_PORT=9944

# Puerto P2P del nodo Midnight
MIDNIGHT_NODE_P2P_PORT=30333

# ─── Cardano ──────────────────────────────────────────────────────────────────

# Blockfrost project ID para Cardano Preprod
# Obtener en: https://blockfrost.io
BLOCKFROST_PROJECT_ID=preprod_xxxxxxxxxxxxxxxxxxxx

# Red de Cardano: preview | preprod | mainnet
CARDANO_NETWORK=preprod

# ─── ALMA Protocol ────────────────────────────────────────────────────────────

# PolicyId del contrato ALMARegistry en Cardano (se completa después del deploy)
ALMA_REGISTRY_POLICY_ID=

# Dirección del contrato ALMACredentialContract en Midnight (se completa después del deploy)
ALMA_CREDENTIAL_CONTRACT_ADDRESS=

# Dirección del contrato de mint público en Cardano (se completa después del deploy)
ALMA_PUBLIC_MINT_CONTRACT_ADDRESS=

# ─── ALDEA ────────────────────────────────────────────────────────────────────

# PolicyId de ALDEA como organización emisora (se completa después de registrar)
ALDEA_ISSUER_POLICY_ID=

# Wallet de tesorería de ALDEA (recibe fondos del mint público)
ALDEA_TREASURY_ADDRESS=

# Precio del mint público en Lovelace (1 ADA = 1_000_000 Lovelace)
ALDEA_MINT_PRICE_LOVELACE=10000000

# ─── Apps ─────────────────────────────────────────────────────────────────────

# URL pública de alma.aldea.world (para redirects y CORS)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# URL de ALDEA World (destino post-mint/claim)
NEXT_PUBLIC_ALDEA_WORLD_URL=https://aldea.world

# Entorno: development | testnet | mainnet
NODE_ENV=development
