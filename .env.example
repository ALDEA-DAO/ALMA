# ALMA Protocol — Environment Variables
# Copy this file as .env and fill in the real values.
# NEVER commit the .env file with real values.

# ─── Midnight ─────────────────────────────────────────────────────────────────

# Proof server URL (local via Docker)
MIDNIGHT_PROOF_SERVER_URL=http://localhost:6300

# Midnight node URL (local via Docker or remote testnet)
MIDNIGHT_NODE_URL=ws://localhost:9944

# Midnight node network preset: testnet-02 | qanet
MIDNIGHT_CFG_PRESET=testnet-02

# Proof server port (change if port conflict)
PROOF_SERVER_PORT=6300

# Midnight node RPC WebSocket port
MIDNIGHT_NODE_PORT=9944

# Midnight node P2P port
MIDNIGHT_NODE_P2P_PORT=30333

# ─── Cardano ──────────────────────────────────────────────────────────────────

# Blockfrost project ID for Cardano Preprod
# Get one at: https://blockfrost.io
BLOCKFROST_PROJECT_ID=preprod_xxxxxxxxxxxxxxxxxxxx

# Cardano network: preview | preprod | mainnet
CARDANO_NETWORK=preprod

# ─── ALMA Protocol ────────────────────────────────────────────────────────────

# PolicyId of ALMARegistry contract on Cardano (filled after deploy)
ALMA_REGISTRY_POLICY_ID=

# SoulboundCredentialContract address on Midnight (filled after deploy)
ALMA_CREDENTIAL_CONTRACT_ADDRESS=

# PublicMint contract address on Cardano (filled after deploy)
ALMA_PUBLIC_MINT_CONTRACT_ADDRESS=

# ─── ALDEA ────────────────────────────────────────────────────────────────────

# ALDEA's PolicyId as issuing organization (filled after registration)
ALDEA_ISSUER_POLICY_ID=

# ALDEA treasury wallet (receives public mint funds)
ALDEA_TREASURY_ADDRESS=

# Public mint price in Lovelace (1 ADA = 1_000_000 Lovelace)
ALDEA_MINT_PRICE_LOVELACE=35000000

# ALDEA admin public key
ALDEA_PUBLIC_KEY=

# ALDEA token policy ID (for token-based minting)
ALDEA_TOKEN_POLICY_ID=

# ALDEA token asset name (hex-encoded)
ALDEA_TOKEN_NAME=414c444541

# ─── Backend API ──────────────────────────────────────────────────────────────

# API server port
PORT=3100

# API public URL (for webhook callbacks)
API_URL=http://localhost:3100

# Database file path (SQLite)
DATABASE_PATH=data/alma-api.db

# ─── Stripe ───────────────────────────────────────────────────────────────────

# Stripe secret key (sk_test_... for testnet, sk_live_... for production)
STRIPE_SECRET_KEY=

# Stripe webhook signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=

# ALMA credential price in USD cents (e.g. 1500 = $15.00)
STRIPE_PRICE_CENTS=1500

# ─── Mercado Pago ─────────────────────────────────────────────────────────────

# Mercado Pago access token (TEST-... for sandbox, APP_USR-... for production)
MP_ACCESS_TOKEN=

# Mercado Pago webhook secret for signature verification
MP_WEBHOOK_SECRET=

# ALMA credential price in ARS (e.g. 15000 = $15,000 ARS)
MP_PRICE_ARS=15000

# ─── Apps ─────────────────────────────────────────────────────────────────────

# Public URL of alma.aldea.world (for redirects and CORS)
NEXT_PUBLIC_APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ALDEA World URL (post-mint/claim redirect destination)
NEXT_PUBLIC_ALDEA_WORLD_URL=https://aldea.world

# Environment: development | testnet | mainnet
NODE_ENV=development
